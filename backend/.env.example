# Server Configuration
HOST=127.0.0.1
PORT=8000

# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mockmate_db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET_KEY=mockmate_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Configuration (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Whisper Speech-to-Text Model Configuration
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
